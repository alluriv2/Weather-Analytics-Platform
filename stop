#!/usr/bin/env bash

set -Eeuo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
NAMESPACE="weather-python"
RUN_DIRECTORY="$ROOT_DIR/local-data/run"
KAFKA_GROUP="weather-postgres-consumer-python"
KAFKA_TOPIC="raw_weather_events_python"

stop_port_forwards() {
    if [[ ! -d "$RUN_DIRECTORY" ]]; then
        return
    fi

    local pid_file

    for pid_file in "$RUN_DIRECTORY"/*.pid; do
        [[ -e "$pid_file" ]] || continue

        local process_id
        process_id="$(cat "$pid_file" 2>/dev/null || true)"

        if [[ "$process_id" =~ ^[0-9]+$ ]] \
            && kill -0 "$process_id" 2>/dev/null; then
            local process_command
            process_command="$(ps -p "$process_id" -o command= 2>/dev/null || true)"

            if [[ "$process_command" == *"kubectl port-forward"* ]] \
                && [[ "$process_command" == *"$NAMESPACE"* ]]; then
                kill "$process_id"
            fi
        fi

        rm -f "$pid_file"
    done
}

wait_for_pods_to_stop() {
    local selector="$1"

    kubectl wait \
        --namespace "$NAMESPACE" \
        --for=delete \
        pod \
        --selector "$selector" \
        --timeout=120s \
        >/dev/null 2>&1 \
        || true
}

consumer_lag() {
    kubectl exec \
        --namespace "$NAMESPACE" \
        kafka-0 \
        -- \
        /opt/kafka/bin/kafka-consumer-groups.sh \
        --bootstrap-server localhost:9092 \
        --describe \
        --group "$KAFKA_GROUP" \
        2>/dev/null \
        | awk -v topic="$KAFKA_TOPIC" \
            '$2 == topic && $6 ~ /^[0-9]+$/ {lag += $6; found = 1} END {if (found) print lag; else print -1}'
}

echo "==> Closing local service ports"
stop_port_forwards

if kubectl cluster-info >/dev/null 2>&1 \
    && kubectl get namespace "$NAMESPACE" >/dev/null 2>&1; then
    echo
    echo "==> Suspending reconciliation"

    if kubectl get cronjob weather-reconciler \
        --namespace "$NAMESPACE" >/dev/null 2>&1; then
        kubectl patch cronjob weather-reconciler \
            --namespace "$NAMESPACE" \
            --type merge \
            --patch '{"spec":{"suspend":true}}'
    fi

    echo
    echo "==> Stopping the producer"

    if kubectl get deployment weather-producer \
        --namespace "$NAMESPACE" >/dev/null 2>&1; then
        kubectl scale deployment/weather-producer \
            --namespace "$NAMESPACE" \
            --replicas=0
        wait_for_pods_to_stop "app.kubernetes.io/name=weather-producer"
    fi

    if kubectl get pod kafka-0 \
        --namespace "$NAMESPACE" >/dev/null 2>&1 \
        && kubectl get deployment weather-consumer \
            --namespace "$NAMESPACE" >/dev/null 2>&1; then
        echo
        echo "==> Allowing the consumer to drain pending Kafka events"

        for _ in {1..60}; do
            current_lag="$(consumer_lag || echo -1)"

            if [[ "$current_lag" == "0" ]]; then
                echo "Kafka consumer lag is zero."
                break
            fi

            sleep 2
        done
    fi

    echo
    echo "==> Stopping application workloads"

    if kubectl get deployments \
        --namespace "$NAMESPACE" \
        --output name 2>/dev/null \
        | grep -q .; then
        kubectl scale deployment --all \
            --namespace "$NAMESPACE" \
            --replicas=0
    fi

    kubectl delete jobs --all \
        --namespace "$NAMESPACE" \
        --ignore-not-found \
        --wait=true

    echo
    echo "==> Stopping Kafka"

    if kubectl get statefulset kafka \
        --namespace "$NAMESPACE" >/dev/null 2>&1; then
        kubectl scale statefulset/kafka \
            --namespace "$NAMESPACE" \
            --replicas=0
        wait_for_pods_to_stop "app.kubernetes.io/name=kafka"
    fi

    echo
    echo "==> Stopping PostgreSQL"

    if kubectl get statefulset postgres \
        --namespace "$NAMESPACE" >/dev/null 2>&1; then
        kubectl scale statefulset/postgres \
            --namespace "$NAMESPACE" \
            --replicas=0
        wait_for_pods_to_stop "app.kubernetes.io/name=postgres"
    fi

else
    echo "Kubernetes is unavailable; no Kubernetes workloads can be changed."
fi

echo
echo "Weather Platform stopped."
echo "PostgreSQL files, Kafka PVC data, database watermarks, configuration, and images were preserved."
